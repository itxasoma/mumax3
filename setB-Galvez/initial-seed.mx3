// ============================================================
//  initial-seed.mx3
//  Snapshot de l'estat inicial de la seed (Gálvez Section 2)
//  Cas: D = 3.0 mJ/m^2  (D7),  Lz = 112 nm
//  NO fa relax ni minimize — només construeix la seed i guarda
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx    := 96
Ny    := 96
Nz    := 112

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat   = 0.384e6
Aex    = 8.78e-12
alpha  = 0.5
Dbulk  = 3.0e-3
Ku1    = 110e3
AnisU  = vector(0, 0, 1)
B_ext  = vector(0, 0, 0)

Lz_nm := 112.0
Lz    := Lz_nm * a

outer   := Cylinder(2*R_out, Lz)
inner   := Cylinder(2*R_in,  Lz)
annulus := outer.Sub(inner)
SetGeom(annulus)

// ── Estat de fons: tot +z ─────────────────────────────────────────────
m = uniform(0, 0, 1)

// ── Seed box ──────────────────────────────────────────────────────────
seed_x := R_out / sqrt(2)
seed_y := R_out / sqrt(2)
box_hx := 10e-9
box_hy := 10e-9

seed_rect := Rect(2*box_hx, 2*box_hy).transl(seed_x, seed_y, 0)

// Regió 1: centre de la seed → -z (tot el rang Z)
defRegion(1, seed_rect)
m.setRegion(1, uniform(0, 0, -1))

// Regió 2: tapa superior → +y
top := seed_rect.Intersect(ZRange(0, Lz/2))
defRegion(2, top)
m.setRegion(2, uniform(0, 1, 0))

// Regió 3: tapa inferior → -y
bot := seed_rect.Intersect(ZRange(-Lz/2, 0))
defRegion(3, bot)
m.setRegion(3, uniform(0, -1, 0))

// ── Cilindre de pinning: r=2.5nm, h=8nm, eix tiltat 15 deg ───────────
pin_r   := 2.5e-9
pin_h   := 8.0 * a
tilt    := 15.0 * pi / 180.0
pin_ux  := sin(tilt) / sqrt(2)
pin_uy  := sin(tilt) / sqrt(2)
pin_uz  := cos(tilt)

pin_cyl := Cylinder(2*pin_r, pin_h).transl(seed_x, seed_y, 0)
defRegion(4, pin_cyl)
AnisU.setRegion(4, vector(pin_ux, pin_uy, pin_uz))

// ── Guardar snapshot ──────────────────────────────────────────────────
saveas(m, "m_D7_Lz112nm_seed")
print("Seed guardada: m_D7_Lz112nm_seed.ovf")
print("D  = 3.0 mJ/m^2  (D7)")
print("Lz = 112 nm")
print("NO s'ha fet relax ni minimize")
