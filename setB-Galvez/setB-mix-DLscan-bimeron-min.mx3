// ============================================================
//  setB-mix-DLscan-bimeron-min.mx3
//  FeGe nanotube: bimeron stability, D vs Lz phase diagram
//  Mixed geometry: our previous tube (R_out=40nm, R_in=32nm, 1nm cell)
//  Fixed Ku = 110 kJ/m^3 (Gálvez bimeron-stable value)
//  Engineered bimeron seed (Section 2, Gálvez et al. 2023)
//
//  Lz = 16, 32, 48, 64, 80, 96, 112, 128 nm  (8 values)
//  D  = 1.0, 1.3, 1.5, 1.7, 2.0, 2.3, 2.5, 3.0 mJ/m^2  (8 values)
//  Total: 64 minimizations
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat  = 0.384e6
Aex   = 8.78e-12
alpha = 0.5

B_ext = vector(0, 0, 0)
AnisU = vector(0, 0, 1)

// Fixed anisotropy: Gálvez bimeron-stable value
Ku1 = 110e3

tableAdd(Dbulk)
tableAdd(Ku1)

// ---- Engineered seed parameters (Gálvez Section 2) ----
// Box centre on nanotube surface at 45 deg: (R_out/sqrt2, R_out/sqrt2, 0)
// With R_out = 40 nm, centre_xy = 40/sqrt(2) ~ 28.28 nm
seed_x := R_out / sqrt(2)
seed_y := R_out / sqrt(2)

// Seed box: 20 x 20 x 30 nm^3 half-extents
box_hx := 10e-9
box_hy := 10e-9
box_hz := 15e-9

// Pinning cylinder: r=2.5 nm, h=8 nm, tilted 15 deg toward radial
pin_r  := 2.5e-9
pin_h  := 8e-9

// Tilt: AnisU_pin = sin(15)*r_hat + cos(15)*z_hat
// r_hat at 45 deg = (1/sqrt2, 1/sqrt2, 0)
tilt   := 15.0 * pi / 180.0
pin_ux := sin(tilt) / sqrt(2)
pin_uy := sin(tilt) / sqrt(2)
pin_uz := cos(tilt)

N_D := 8
N_L := 8

for iD := 0; iD < N_D; iD++ {

    d_val := 0.0
    if iD == 0 { d_val = 1.0e-3 }
    if iD == 1 { d_val = 1.3e-3 }
    if iD == 2 { d_val = 1.5e-3 }
    if iD == 3 { d_val = 1.7e-3 }
    if iD == 4 { d_val = 2.0e-3 }
    if iD == 5 { d_val = 2.3e-3 }
    if iD == 6 { d_val = 2.5e-3 }
    if iD == 7 { d_val = 3.0e-3 }

    Dbulk = d_val

    for iL := 0; iL < N_L; iL++ {

        Lz_nm := 16 * (iL + 1)
        Lz    := 1e-9 * Lz_nm

        // ----- Geometry -----
        outer   := Cylinder(2*R_out, Lz)
        inner   := Cylinder(2*R_in,  Lz)
        annulus := outer.Sub(inner)
        SetGeom(annulus)

        // ----- Anisotropy regions -----
        // Region 0: bulk nanotube — global easy axis z
        Ku1.SetRegion(0, 110e3)
        AnisU.SetRegion(0, vector(0, 0, 1))

        // Region 1: pinning cylinder — tilted 15 deg toward radial
        pinCyl := Cylinder(2*pin_r, pin_h).Transl(seed_x, seed_y, 0)
        DefRegion(1, pinCyl)
        Ku1.SetRegion(1, 110e3)
        AnisU.SetRegion(1, vector(pin_ux, pin_uy, pin_uz))

        // ----- Engineered initial magnetization -----
        // Step 1: uniform +z background
        m = uniform(0, 0, 1)

        // Step 2: seed box core → -z
        m.SetInShape(
            Cuboid(2*box_hx, 2*box_hy, 2*box_hz).Transl(seed_x, seed_y, 0),
            Uniform(0, 0, -1))

        // Step 3: upper half of box (z > 0) → +y
        m.SetInShape(
            Cuboid(2*box_hx, 2*box_hy, box_hz).Transl(seed_x, seed_y, box_hz/2),
            Uniform(0, 1, 0))

        // Step 4: lower half of box (z < 0) → -y
        m.SetInShape(
            Cuboid(2*box_hx, 2*box_hy, box_hz).Transl(seed_x, seed_y, -box_hz/2),
            Uniform(0, -1, 0))

        // ----- Minimize -----
        minimize()

        saveas(m, sprint("m_D", iD, "_Lz", Lz_nm, "nm"))
        tablesave()

        print("Done  iD=", iD, "  D=", d_val*1e3, " mJ/m^2  Lz=", Lz_nm, " nm")
    }
}

print("=== setB-mix DLscan bimeron complete ===")