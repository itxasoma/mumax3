// ============================================================
//  comparison.mx3
//  Compare relax() vs minimize() for one setA cubic+H case
//  Case chosen: Lz = 64 nm, mu0 H = 0.2 T
//  Geometry and material from setA-Cortes-Ortuno
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat  = 0.384e6
Aex   = 8.78e-12
alpha = 0.5

Dbulk = 0.0

// setA cubic anisotropy
Kc1 = -6e3
Kc2 = 12e3

// chosen comparison case
Lz_nm := 64
Lz    := 1e-9 * Lz_nm
h_val := 0.2
B_ext = vector(0, 0, h_val)

// geometry
outer   := Cylinder(2*R_out, Lz)
inner   := Cylinder(2*R_in,  Lz)
annulus := outer.Sub(inner)
SetGeom(annulus)

// energies to table
tableAdd(E_total)
tableAdd(E_exch)
tableAdd(E_DMI)
tableAdd(E_anis)
tableAdd(E_demag)

// initial state
m = randomMag()
saveas(m, "m_init")

print("=== CASE: cubic + H comparison ===")
print("Lz = ", Lz_nm, " nm")
print("mu0 H = ", h_val, " T")
print("Kc1 = ", Kc1, " J/m^3")
print("Kc2 = ", Kc2, " J/m^3")

// ---------- relax ----------
print("=== RUN 1: relax() ===")
relax()
saveas(m, "m_relax")
tablesave()

// restore the exact same initial state
m.LoadFile("m_init.ovf")

// ---------- minimize ----------
print("=== RUN 2: minimize() ===")
minimize()
saveas(m, "m_minimize")
tablesave()

print("=== comparison complete ===")
print("Row 1 in table.txt -> relax()")
print("Row 2 in table.txt -> minimize()")
