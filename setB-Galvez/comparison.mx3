// ============================================================
//  comparison.mx3
//  Compare relax() vs minimize() for two setA cubic+H cases
//  Case 1: Lz = 32 nm, H = 0.0 T
//  Case 2: Lz = 96 nm, H = 0.1 T
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat  = 0.384e6
Aex   = 8.78e-12
alpha = 0.5
Dbulk = 0.0

Kc1 = -6e3
Kc2 = 12e3

// energies to table
tableAdd(E_total)
tableAdd(E_exch)
tableAdd(E_anis)
tableAdd(E_demag)
tableAdd(E_zeeman)

// ══════════════════════════════════════════════════════════════
//  CASE 1: Lz = 32 nm, H = 0.0 T
// ══════════════════════════════════════════════════════════════
Lz_nm := 32.0
Lz    := Lz_nm * a
h_val := 0.0
B_ext = vector(0, 0, h_val)

outer   := Cylinder(2*R_out, Lz)
inner   := Cylinder(2*R_in,  Lz)
annulus := outer.Sub(inner)
SetGeom(annulus)

m = randomMag()
saveas(m, "m_init_case1")

print("=== CASE 1: Lz=32nm  H=0.0T ===")

print("--- RUN 1a: relax() ---")
relax()
saveas(m, "m_relax_case1")
tablesave()

m.LoadFile("comparison.out/m_init_case1.ovf")

print("--- RUN 1b: minimize() ---")
minimize()
saveas(m, "m_minimize_case1")
tablesave()

print("=== CASE 1 complete. Rows 1-2 in table.txt ===")

// ══════════════════════════════════════════════════════════════
//  CASE 2: Lz = 96 nm, H = 0.1 T
// ══════════════════════════════════════════════════════════════
Lz_nm = 96.0
Lz     = Lz_nm * a
h_val  = 0.1
B_ext = vector(0, 0, h_val)

outer   = Cylinder(2*R_out, Lz)
inner   = Cylinder(2*R_in,  Lz)
annulus = outer.Sub(inner)
SetGeom(annulus)

m = randomMag()
saveas(m, "m_init_case2")

print("=== CASE 2: Lz=96nm  H=0.1T ===")

print("--- RUN 2a: relax() ---")
relax()
saveas(m, "m_relax_case2")
tablesave()

m.LoadFile("comparison.out/m_init_case2.ovf")

print("--- RUN 2b: minimize() ---")
minimize()
saveas(m, "m_minimize_case2")
tablesave()

print("=== CASE 2 complete. Rows 3-4 in table.txt ===")
print("=== comparison.mx3 finished ===")
print("Rows: 1=relax case1  2=minimize case1  3=relax case2  4=minimize case2")
