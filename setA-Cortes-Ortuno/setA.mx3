// ============================================================
//  Set A — Cortés-Ortuño 2018 benchmark material
//  Nanotube: hollow cylinder, axis = z, PBC along z
//  Interfacial DMI (Cnv) × AXIAL external field (B along z)
//
//  Reference: Cortés-Ortuño et al., New J. Phys. 20, 113015 (2018)
//    Ms=860kA/m    A=13pJ/m    Ku=0.4MJ/m^3    D=0→3mJ/m^2
//    Lex~5.3nm ->  cell=2nm    LD~54.5nm ->    L=160nm
//
//  Companion: setA-Hrad.mx3 applies a radial field instead.
// ============================================================

Nx    := 32
Ny    := 32
Nz    := 80
a     := 2e-9
R_out := 30e-9
R_in  := 24e-9
L     := 160e-9

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)
// SetPBC(0, 0, 4)

outer   := Cylinder(2*R_out, L)
inner   := Cylinder(2*R_in, L)
annulus := outer.Sub(inner)
SetGeom(annulus)

Msat  = 860e3
Aex   = 13e-12
Ku1   = 0.4e6
AnisU = vector(0, 0, 1)
alpha = 0.5

// ── Output table columns ──────────────────────────────────────────────────────
tableadd(Dind)
tableadd(B_ext)

// ── Phase diagram scan ────────────────────────────────────────────────────────
N_D   := 11
N_H   := 11
D_max := 3.0e-3
B_max := mu0 * 860e3   // ~1.08 T  (= mu0*Ms, saturation scale)

for iD := 0; iD < N_D; iD++ {
    d_val := D_max * (1.0*iD) / (1.0*(N_D-1))
    Dind = d_val

    for iH := 0; iH < N_H; iH++ {
        b_val := B_max * (1.0*iH) / (1.0*(N_H-1))

        // Uniform axial field
        B_ext = vector(0, 0, b_val)

        m = randomMag()
        relax()

        saveas(m, sprint("m_", iD, "_", iH))
        tablesave()

        print("Done  iD=", iD, "  iH=", iH, "  Dind=", d_val, "  B_axial=", b_val)
    }
}

print("=== Scan complete — output in setA.out/ ===")
