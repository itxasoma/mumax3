//output directory: setA-Lscan.out/
//starting GUI at http://127.0.0.1:35367
a := 1e-9
R_out := 40e-9
R_in := 32e-9
Nx := 96
Ny := 96
Nz := 128
SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)
EdgeSmooth = 8
Msat = 0.384e6
Aex = 8.78e-12
alpha = 0.5
Dbulk = 0.0
B_ext = vector(0, 0, 0)
N_L := 8
for iL := 0; iL < N_L; iL++ {
	Lz_nm := 16 * (iL + 1)
	Lz := 1e-9 * Lz_nm
	outer := Cylinder(2*R_out, Lz)
	inner := Cylinder(2*R_in, Lz)
	annulus := outer.Sub(inner)
	SetGeom(annulus)
	m = randomMag()
	relax()
	saveas(m, sprint("m_Lz", Lz_nm, "nm"))
	print("Done  iL=", iL, "  Lz=", Lz_nm, " nm")
}
