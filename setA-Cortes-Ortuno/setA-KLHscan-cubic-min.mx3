// ============================================================
//  setA-KLHscan-cubic-H3-min.mx3
//  FeGe nanotube: Lz scan for Hz = 0.05 T only (H3 case)
//  Cubic anisotropy fixed at FeGe bulk values (Niitsu et al. 2022)
//  Kc1 = -6 kJ/m^3, Kc2 = +12 kJ/m^3
//
//  Lengths : Lz = 16, 32, 48, 64, 80, 96, 112, 128 nm  (8 values)
//  Hz = 0.05 T  (single value, iH=3)
//  Total: 8 minimizations
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat  = 0.384e6
Aex   = 8.78e-12

Kc1 = -6e3
Kc2 = 12e3

B_ext = vector(0, 0, 0.05)

tableAdd(Kc1)
tableAdd(Kc2)

N_L := 8
iH  := 3      // label consistent with the full scan

for iL := 0; iL < N_L; iL++ {

    Lz_nm := 16 * (iL + 1)
    Lz    := 1e-9 * Lz_nm

    outer   := Cylinder(2*R_out, Lz)
    inner   := Cylinder(2*R_in,  Lz)
    annulus := outer.Sub(inner)
    SetGeom(annulus)

    m = randomMag()
    minimize()

    saveas(m, sprint("m_H", iH, "_Lz", Lz_nm, "nm"))
    tablesave()

    print("Done  iH=", iH, "  Hz=0.05 T  Lz=", Lz_nm, " nm")
}

print("=== H3 cubic scan complete ===")