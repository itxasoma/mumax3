//output directory: setA.out/
//starting GUI at http://127.0.0.1:35367
Nx := 32
Ny := 32
Nz := 80
a := 2e-9
R_out := 30e-9
R_in := 24e-9
L := 160e-9
SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)
SetPBC(0, 0, 4)
//resizing...
outer := Cylinder(2*R_out, L)
inner := Cylinder(2*R_in, L)
annulus := outer.Sub(inner)
SetGeom(annulus)
// Initializing geometry 0 %
// Initializing geometry 100 %
Msat = 860e3
Aex = 13e-12
Ku1 = 0.4e6
AnisU = vector(0, 0, 1)
alpha = 0.5
tableadd(Dind)
tableadd(B_ext)
N_D := 11
N_H := 11
D_max := 3.0e-3
B_max := mu0 * 860e3
for iD := 0; iD < N_D; iD++ {
	d_val := D_max * (1.0 * iD) / (1.0 * (N_D - 1))
	Dind = d_val
	for iH := 0; iH < N_H; iH++ {
		b_val := B_max * (1.0 * iH) / (1.0 * (N_H - 1))
		B_ext = vector(0, 0, b_val)
		m = randomMag()
		relax()
		saveas(m, sprint("m_", iD, "_", iH))
		tablesave()
		print("Done  iD=", iD, "  iH=", iH, "  Dind=", d_val, "  B_axial=", b_val)
	}
}
