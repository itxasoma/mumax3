// ============================================================
//  setA-Lscan.mx3
//  FeGe nanotube length scan at D=0, H=0, Ku=0
//  Goal: follow the flower -> crossover -> vortex evolution
//  as Lz increases, with only exchange + demagnetization
//
//  Geometry fixed in x,y:
//    a     = 1 nm
//    R_in  = 32 nm
//    R_out = 40 nm
//    no PBC
//    EdgeSmooth = 8
//
//  Length scan:
//    Lz = 16, 32, 48, 64, 80, 96, 112, 128 nm
//
//  Notes:
//  - We use one common simulation box with Nz=128.
//  - The tube length is changed by redefining the geometry only.
// ============================================================

// --- Cell size and maximum box ---
a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

// --- FeGe material parameters (Table 3, Cortés-Ortuño) ---
Msat  = 0.384e6
Aex   = 8.78e-12
alpha = 0.5

// --- No anisotropy, no DMI, no external field ---
Dbulk = 0.0
B_ext = vector(0, 0, 0)
// Ku1 intentionally omitted

// --- Scan over tube length ---
N_L := 8   // 16, 32, ..., 128 nm

for iL := 0; iL < N_L; iL++ {

    Lz_nm := 16 * (iL + 1)
    Lz    := 1e-9 * Lz_nm

    // Rebuild geometry for this length
    outer   := Cylinder(2*R_out, Lz)
    inner   := Cylinder(2*R_in,  Lz)
    annulus := outer.Sub(inner)
    SetGeom(annulus)

    // Random initial state for each length
    m = randomMag()

    // Relax to equilibrium
    relax()

    // Save snapshot
    saveas(m, sprint("m_Lz", Lz_nm, "nm"))

    print("Done  iL=", iL, "  Lz=", Lz_nm, " nm")
}

print("=== Lz scan complete — output in setA-Lscan.out/ ===")