// ============================================================
//  setA-Hrad-2.mx3
//  FeGe bulk-DMI parameters — Table 3, Cortés-Ortuño 2018
//  Geometry: R_int=32nm, R_out=40nm, L=32nm, a=1nm
//  No PBC — finite-size effects in z visible
//  Test: no H, no DMI → expect flower state (short tube, Lz=32nm)
// ============================================================

// --- Cell size ---
a := 1e-9   // 1 nm cell — well below exchange length (~6.8 nm for FeGe)

// --- Grid: fit tightly around the tube ---
// Tube outer diameter = 80 nm → 80 cells in x,y
// Add 8 cells padding each side → 96 (multiple of 8 for FFT efficiency)
// Length L = 32 nm → 24 cells + 8 padding → round to 32
Nx := 96
Ny := 96
Nz := 32
SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

// EdgeSmooth: maximum recommended value is 8
EdgeSmooth = 8

// --- Geometry: hollow cylinder (nanotube), no PBC ---
R_out := 40e-9
R_in  := 32e-9
SetGeom(Cylinder(2*R_out, Nz*a).Sub(Cylinder(2*R_in, Nz*a)))
// No SetPBC — finite size in all directions

// --- FeGe material parameters (Table 3, Cortés-Ortuño 2018) ---
Msat  = 0.384e6   // 0.384 MA/m
Aex   = 8.78e-12  // 8.78 pJ/m
alpha = 0.5       // damping for fast relaxation

// --- DMI: SET TO ZERO for flower-state test ---
// FeGe has bulk (T-symmetry) DMI → use Dbulk
// Uncomment for full scan:
// Dbulk = 1.58e-3
Dbulk = 0.0

// --- External field: OFF for flower-state test ---
// Uncomment for full scan (radial field):
// B_ext = vector(...)
B_ext = vector(0, 0, 0)

// --- No uniaxial anisotropy (FeGe bulk, small cubic K neglected) ---
// Ku1 = 0

// --- Initial state: random ---
randomMag()

// --- Output ---
autosave(m, 100e-12)    // save spin texture every 100 ps during relax
tableAdd(Dbulk)
tableAutoSave(10e-12)

// --- Relax ---
relax()

// --- Final snapshot ---
save(m)
