// ============================================================
//  setA-KLscan-uniaxial-K3-min.mx3
//  FeGe nanotube: Lz scan for Ku = 50 kJ/m^3 only (K3 case)
//  No DMI, no external field
//
//  Lengths : Lz = 16, 32, 48, 64, 80, 96, 112, 128 nm  (8 values)
//  Ku = 50 kJ/m^3  (single value, iK=3)
//  Total: 8 minimizations
// ============================================================

a     := 1e-9
R_out := 40e-9
R_in  := 32e-9

Nx := 96
Ny := 96
Nz := 128

SetGridsize(Nx, Ny, Nz)
SetCellsize(a, a, a)

EdgeSmooth = 8

Msat  = 0.384e6
Aex   = 8.78e-12

Dbulk = 0.0
B_ext = vector(0, 0, 0)

AnisU = vector(0, 0, 1)
Ku1   = 50e3

tableAdd(Ku1)

N_L := 8
iK  := 3      // label consistent with the full scan

for iL := 0; iL < N_L; iL++ {

    Lz_nm := 16 * (iL + 1)
    Lz    := 1e-9 * Lz_nm

    outer   := Cylinder(2*R_out, Lz)
    inner   := Cylinder(2*R_in,  Lz)
    annulus := outer.Sub(inner)
    SetGeom(annulus)

    m = randomMag()
    minimize()

    saveas(m, sprint("m_Ku", iK, "_Lz", Lz_nm, "nm"))
    tablesave()

    print("Done  iK=", iK, "  Ku=50 kJ/m^3  Lz=", Lz_nm, " nm")
}

print("=== K3 uniaxial scan complete ===")